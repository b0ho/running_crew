# LearnKK 로컬 스택 환경변수 템플릿
# 실제 값을 담은 .env 는 절대 커밋하지 않는다(.gitignore, R-U1-26).
# 사용법: cp .env.example .env  후 값을 채운다.

# --- 데이터베이스 ---
DB_NAME=learnkk
DB_USERNAME=learnkk
DB_PASSWORD=change-me-db-password

# --- 관리자 시드 (R-U1-26/27, 미설정 시 API 부팅 중단) ---
ADMIN_EMAIL=admin@learnkk.local
ADMIN_PASSWORD=change-me-admin-password

# --- 보안 ---
# BCrypt cost (기본 10, 하한 8)
BCRYPT_COST=10

# --- 포트 ---
API_PORT=8080
WEB_PORT=8081

# --- CORS (FE 오리진) ---
CORS_ALLOWED_ORIGINS=http://localhost:8081
